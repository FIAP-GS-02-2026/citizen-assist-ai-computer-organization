{
  "version": 1,
  "author": "Gabriel Fagundes, Glauco Kelly, Thiago Renatino - GS 2026.2 FIAP",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-lcd1602", "id": "lcd", "top": -150, "left": -60, "attrs": { "pins": "i2c" } },
    {
      "type": "wokwi-pushbutton",
      "id": "btnChegada",
      "top": -40,
      "left": 300,
      "attrs": { "color": "green", "label": "CHEGADA", "bounce": "1" }
    },
    {
      "type": "wokwi-pushbutton",
      "id": "btnAtendimento",
      "top": 60,
      "left": 300,
      "attrs": { "color": "blue", "label": "ATENDIMENTO", "bounce": "1" }
    },
    { "type": "wokwi-led", "id": "ledVerde", "top": 30, "left": 170, "attrs": { "color": "green", "label": "NORMAL" } },
    { "type": "wokwi-led", "id": "ledVermelho", "top": 30, "left": 230, "attrs": { "color": "red", "label": "ALERTA" } },
    { "type": "wokwi-resistor", "id": "rVerde", "top": 130, "left": 160, "rotate": 90, "attrs": { "value": "220" } },
    { "type": "wokwi-resistor", "id": "rVermelho", "top": 130, "left": 220, "rotate": 90, "attrs": { "value": "220" } }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],

    [ "btnChegada:1.l", "esp:15", "green", [] ],
    [ "btnChegada:2.l", "esp:GND.2", "black", [] ],
    [ "btnAtendimento:1.l", "esp:13", "blue", [] ],
    [ "btnAtendimento:2.l", "esp:GND.2", "black", [] ],

    [ "esp:2", "rVerde:1", "green", [] ],
    [ "rVerde:2", "ledVerde:A", "green", [] ],
    [ "ledVerde:C", "esp:GND.2", "black", [] ],
    [ "esp:4", "rVermelho:1", "red", [] ],
    [ "rVermelho:2", "ledVermelho:A", "red", [] ],
    [ "ledVermelho:C", "esp:GND.2", "black", [] ],

    [ "lcd:GND", "esp:GND.2", "black", [] ],
    [ "lcd:VCC", "esp:5V", "red", [] ],
    [ "lcd:SDA", "esp:21", "orange", [] ],
    [ "lcd:SCL", "esp:22", "purple", [] ]
  ],
  "dependencies": {}
}
